[Unit]
Description=AI Power Grid remote MCP resource
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/usr/bin/node
ConditionPathIsDirectory=/opt/aipg-mcp/current
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=aipg-mcp
Group=aipg-mcp
WorkingDirectory=/opt/aipg-mcp/current
EnvironmentFile=/etc/aipg/mcp.env
Environment=NODE_ENV=production
Environment=AIPG_MCP_HOST=127.0.0.1
Environment=AIPG_MCP_PORT=8788
ExecStartPre=/usr/bin/test -r /etc/aipg/mcp.env
ExecStart=/usr/bin/node /opt/aipg-mcp/current/dist/http.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LimitNOFILE=4096
TasksMax=128

[Install]
WantedBy=multi-user.target
