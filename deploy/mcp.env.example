# Copy to /etc/aipg/mcp.env with root:aipg-mcp ownership and mode 0640.
# Supply only the introspection-only grid-mcp service key. Never use an ordinary
# user API key or a frontend service key.
AIPG_MCP_SERVICE_KEY=
# Keep OAuth issuer/audience public while avoiding a Cloudflare hairpin for
# introspection and long-running inference on the production Core host.
AIPG_MCP_CORE_INTERNAL_URL=http://127.0.0.1:7010
